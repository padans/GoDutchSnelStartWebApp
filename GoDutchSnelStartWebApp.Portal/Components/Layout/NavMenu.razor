@using GoDutchSnelStartWebApp.Portal.Services
@inject AppSession Session
@inject IJSRuntime JSRuntime
@implements IDisposable

<nav class="app-nav">
    <div class="app-brand">
        <div class="app-brand-title">GoDutch SnelStart</div>
        <div class="app-brand-subtitle">Koppelingen &amp; exports</div>
    </div>

    @* Overzicht — altijd zichtbaar *@
    <div class="app-nav-section">
        <div class="app-nav-heading-dark">Overzicht</div>

        <NavLink class="app-nav-link" @onclick="ScrollToContent" href="" Match="NavLinkMatch.All">
            <span class="app-nav-link-icon">🏠</span>
            <span>Start</span>
        </NavLink>

        <NavLink class="app-nav-link" @onclick="ScrollToContent" href="notifications" Match="NavLinkMatch.Prefix">
            <span class="app-nav-link-icon">🔔</span>
            <span>Meldingen</span>
            <NotificationBadge />
        </NavLink>
    </div>

    @* GoDutch — zichtbaar voor Beheerder en GoDutch *@
    @if (IsModuleVisible("GoDutch"))
    {
        <div class="app-nav-section">
            <div class="app-nav-heading-dark">GoDutch</div>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="bankaccounts" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🏦</span>
                <span>Bankaccounts</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="godutch/sync" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🔁</span>
                <span>Sync &amp; instellingen</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="snelstart/administrations" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🏢</span>
                <span>SnelStart administraties</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="snelstart/connection" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🔗</span>
                <span>SnelStart koppeling</span>
            </NavLink>

        </div>
    }

    @* MyPos — zichtbaar voor Beheerder en MyPos *@
    @if (IsModuleVisible("MyPos"))
    {
        <div class="app-nav-section">
            <div class="app-nav-heading-dark">MyPos</div>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="mypos/administrations" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🏢</span>
                <span>MyPos administratie</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="mypos/connection" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🔌</span>
                <span>Verbinding</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="mypos/import" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">📥</span>
                <span>Import</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="mypos/mappings" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🗂️</span>
                <span>Mappings</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="mypos/auto-sync" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">⚙️</span>
                <span>Auto-sync</span>
            </NavLink>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="mypos/type-status" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">📊</span>
                <span>Transactie types</span>
            </NavLink>
        </div>
    }

    @* Beheer — alleen voor Beheerder *@
    @if (IsBeheerder())
    {
        <div class="app-nav-section">
            <div class="app-nav-heading-dark">Beheer</div>

            <NavLink class="app-nav-link" @onclick="ScrollToContent" href="tenants/onboard" Match="NavLinkMatch.Prefix">
                <span class="app-nav-link-icon">🏢</span>
                <span>Tenant onboarden</span>
            </NavLink>
        </div>
    }

    <div class="app-nav-footer">
        <div class="app-nav-user-info">
            @if (!string.IsNullOrEmpty(Session.TenantName))
            {
                <div class="app-nav-tenant">@Session.TenantName</div>
            }
            <div class="app-nav-username">@Session.Username</div>
        </div>
        <button class="app-nav-logout-btn" @onclick="HandleLogout">
            <span>⬅</span> Uitloggen
        </button>
    </div>
</nav>

@code {
    protected override void OnInitialized()
    {
        Session.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
    }

    private bool IsModuleVisible(string module) =>
        IsBeheerder() ||
        string.Equals(Session.Module, module, StringComparison.OrdinalIgnoreCase);

    private bool IsBeheerder() =>
        string.Equals(Session.Module, "Beheerder", StringComparison.OrdinalIgnoreCase);

    private async Task ScrollToContent()
    {
        try { await JSRuntime.InvokeVoidAsync("requestScrollToContent"); } catch { }
    }

    private async Task HandleLogout()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "session_username");
            await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "session_module");
            await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "session_tenantname");
        }
        catch { }
        Session.Logout();
    }
}
