    /* ── Tabs ───────────────────────────────────────────────────── */
    .panel-tabs {
        display: flex;
        background: #F0F4F9;
        border-radius: 10px;
        padding: 4px;
        margin-bottom: 24px;
        gap: 4px;
    }

    .panel-tab {
        flex: 1;
        background: transparent;
        border: none;
        border-radius: 7px;
        padding: 9px 4px;
        font-size: .875rem;
        font-weight: 600;
        color: #6B7280;
        cursor: pointer;
        transition: background .15s, color .15s;
    }

    .panel-tab:hover {
        color: #0066CC;
    }

    .panel-tab-active {
        background: #ffffff;
        color: #0057AD;
        box-shadow: 0 2px 8px rgba(0,46,92,.10);
    }

    /* ── Formuliervelden ────────────────────────────────────────── */
    .login-field {
        margin-bottom: 14px;
    }

    .login-field label {
        display: block;
        font-weight: 600;
        font-size: .84rem;
        color: #374151;
        margin-bottom: 5px;
    }

    .req {
        color: #DC2626;
    }

    .login-error {
        background: #FEF2F2;
        border: 1px solid #FECACA;
        color: #DC2626;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: .84rem;
        margin-bottom: 12px;
    }

    .login-btn {
        width: 100%;
        background: #0066CC;
        color: #ffffff;
        border: none;
        border-radius: 10px;
        padding: 13px;
        font-size: .95rem;
        font-weight: 600;
