@page "/snelstart/connection"

@using GoDutchSnelStartWebApp.Portal.Configuration
@using GoDutchSnelStartWebApp.Portal.Models
@using Microsoft.Extensions.Options

@inject IBackendApiClient BackendApiClient
@inject IOptions<PortalTenantOptions> TenantOptions
@inject ILogger<SnelStartConnection> Logger
@inject AppSession Session

<PageTitle>SnelStart koppeling</PageTitle>

<h1 class="mb-1">SnelStart koppeling</h1>
<p class="text-muted mb-4">
    @if (Session.Module == "Beheerder")
    {
        <span>Beheer de SnelStart API-verbinding, administraties en de koppeling van bankaccounts per administratie.</span>
    }
    else
    {
        <span>Voer uw maatwerksleutel in en koppel uw SnelStart-administratie aan bankaccounts.</span>
    }
</p>

@if (!string.IsNullOrWhiteSpace(pageError))
{
    <div class="alert alert-danger">@pageError</div>
}

@if (isLoading)
{
    <p class="text-muted">Gegevens laden...</p>
}
else
{
    @* ─── SECTIE 1: Globale API-verbinding — alleen voor Beheerder (apart beheerd via /beheerder/snelstart-api) ─── *@
    @if (false) // uitgezet — zie beheerderpagina
    {
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><strong>Globale API-verbinding</strong> — gedeeld voor alle administraties</span>
            @if (connection is not null)
            {
                <span class="badge @(connection.IsActive ? "bg-success" : "bg-secondary")">
                    @(connection.IsActive ? "Actief" : "Inactief")
                </span>
            }
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(connSuccess))
            {
                <div class="alert alert-success py-2">@connSuccess</div>
            }
            @if (!string.IsNullOrWhiteSpace(connError))
            {
                <div class="alert alert-danger py-2">@connError</div>
            }

            @if (connection is null)
            {
                <div class="alert alert-warning mb-3">
                    Nog geen globale API-verbinding aangemaakt.
                </div>
                <div class="fixed-url-row mb-3">
                    <span class="fixed-url-chip"><span class="fixed-url-label">Auth URL</span> https://auth.snelstart.nl/b2b/token</span>
                    <span class="fixed-url-chip"><span class="fixed-url-label">API Base URL</span> https://b2bapi.snelstart.nl/v2</span>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Subscription Key</label>
                        <input class="form-control" type="password" @bind="createConn.SubscriptionKey" autocomplete="off" />
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary" @onclick="CreateConnectionAsync" disabled="@isSavingConn">
                            @(isSavingConn ? "Aanmaken..." : "Verbinding aanmaken")
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="fixed-url-row mb-3">
                    <span class="fixed-url-chip"><span class="fixed-url-label">Auth URL</span> https://auth.snelstart.nl/b2b/token</span>
                    <span class="fixed-url-chip"><span class="fixed-url-label">API Base URL</span> https://b2bapi.snelstart.nl/v2</span>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Subscription Key</label>
                        <input class="form-control" type="password" @bind="connSubscriptionKey" autocomplete="off"
                               placeholder="@(connection.HasSubscriptionKey ? "Laat leeg om te behouden" : "Vul in")" />
                        <div class="form-text">Opgeslagen: @(connection.HasSubscriptionKey ? "Ja" : "Nee")</div>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="connActive" @bind="connection.IsActive" />
                            <label class="form-check-label" for="connActive">Actief</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary" @onclick="SaveConnectionAsync" disabled="@isSavingConn">
                            @(isSavingConn ? "Opslaan..." : "Opslaan")
                        </button>
                        <button class="btn btn-outline-secondary ms-2" @onclick="LoadAsync" disabled="@isSavingConn">
                            Vernieuwen
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
    }
    @if (connection is null)
    {
        <div class="alert alert-warning mb-4">
            De SnelStart API-verbinding is nog niet ingesteld. Neem contact op met Padans om dit eenmalig te laten activeren.
        </div>
    }

    @* ─── SECTIE 1.5: Maatwerksleutel (ClientKey op verbindingsniveau) ─── *@
    @if (connection is not null)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Maatwerksleutel</strong>
                <span class="badge @(connection.HasClientKey ? "bg-success" : "bg-warning text-dark")">
                    @(connection.HasClientKey ? "✓ Ingesteld" : "Nog niet ingesteld")
                </span>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(clientKeySuccess))
                {
                    <div class="alert alert-success py-2">@clientKeySuccess</div>
                }
                @if (!string.IsNullOrWhiteSpace(clientKeyError))
                {
                    <div class="alert alert-danger py-2">@clientKeyError</div>
                }
                @if (!connection.HasClientKey)
                {
                    <p class="text-muted mb-3">
                        Voer uw SnelStart maatwerksleutel in om de koppeling te activeren.
                        Deze vindt u in SnelStart via <em>Koppelingen → Maatwerk</em>.
                    </p>
                }
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">
                            Maatwerksleutel
                            @if (!connection.HasClientKey) { <span class="text-danger">*</span> }
                        </label>
                        <input type="text" style="display:none" aria-hidden="true" tabindex="-1" />
                        <input type="password" style="display:none" aria-hidden="true" tabindex="-1" />
                        <input class="form-control" type="password" @bind="clientKeyInput" autocomplete="new-password"
                               placeholder="@(connection.HasClientKey ? "Laat leeg om te behouden" : "Voer uw maatwerksleutel in")" />
                        @if (connection.HasClientKey)
                        {
                            <div class="form-text">Opgeslagen: ✓ Ja</div>
                        }
                        <div class="maatwerk-help-toggle mt-2">
                            <button type="button" class="maatwerk-help-btn" @onclick="() => _showMaatwerkHelp = !_showMaatwerkHelp">
                                <span>&#x2139;&#xFE0F;</span>
                                <span>Hoe haal ik de maatwerksleutel op uit SnelStart?</span>
                                <span class="maatwerk-help-chevron">@(_showMaatwerkHelp ? "&#9650;" : "&#9660;")</span>
                            </button>
                        </div>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary" @onclick="SaveClientKeyAsync" disabled="@isSavingClientKey">
                            @(isSavingClientKey ? "Opslaan..." : (connection.HasClientKey ? "Bijwerken" : "Opslaan"))
                        </button>
                        @if (connection.HasClientKey)
                        {
                            <button class="btn btn-outline-secondary ms-2" @onclick="TestConnectionAsync" disabled="@_isTesting">
                                @(_isTesting ? "Testen..." : "🔌 Verbinding testen")
                            </button>
                        }
                    </div>
                </div>
                @if (_testResult is not null)
                {
                    <div class="alert @(_testResult.Success ? "alert-success" : "alert-danger") mt-3 py-2" role="alert">
                        @if (_testResult.Success)
                        {
                            <strong>✓ Verbinding geslaagd</strong>
                        }
                        else
                        {
                            <strong>✗ Verbinding mislukt</strong>
                        }
                        — @_testResult.Message
                        @if (!string.IsNullOrWhiteSpace(_testResult.TestedUrl))
                        {
                            <div class="small text-muted mt-1">URL: @_testResult.TestedUrl</div>
                        }
                    </div>
                }
                @if (_showMaatwerkHelp)
                {
                    <div class="maatwerk-help-panel">
                        <p class="maatwerk-help-intro">Volg deze stappen om de maatwerksleutel op te halen uit SnelStart:</p>
                        <ol class="maatwerk-help-steps">
                            <li>Log in op <strong>SnelStart</strong> en ga in het linkermenu naar <strong>Koppelingen</strong>.</li>
                            <li>
                                Zoek op <em>maatwerk</em> en klik op <strong>Maatwerk</strong> van SnelStart Software B.V.
                                <div class="maatwerk-example-toggle mt-1">
                                    <button type="button" class="maatwerk-example-btn" @onclick="() => _showSs02 = !_showSs02">&#x1F5BC;&#xFE0F; @(_showSs02 ? "Verberg" : "Toon") voorbeeld</button>
                                </div>
                                @if (_showSs02)
                                {
                                    <img class="maatwerk-example-img" src="data:image/png;base64," alt="SnelStart Koppelingen zoeken op maatwerk" />
                                }
                            </li>
                            <li>
                                Klik op <strong>Genereer nieuwe sleutel</strong> als u nog geen sleutel heeft.
                                <div class="maatwerk-example-toggle mt-1">
                                    <button type="button" class="maatwerk-example-btn" @onclick="() => _showSs03 = !_showSs03">&#x1F5BC;&#xFE0F; @(_showSs03 ? "Verberg" : "Toon") voorbeeld</button>
                                </div>
                                @if (_showSs03)
                                {
                                    <img class="maatwerk-example-img" src="data:image/png;base64," alt="SnelStart maatwerksleutel pagina" />
                                }
                            </li>
                            <li>
                                Bevestig de melding — de bestaande koppeling wordt vervangen.
                                <div class="maatwerk-example-toggle mt-1">
                                    <button type="button" class="maatwerk-example-btn" @onclick="() => _showSs04 = !_showSs04">&#x1F5BC;&#xFE0F; @(_showSs04 ? "Verberg" : "Toon") voorbeeld</button>
                                </div>
                                @if (_showSs04)
                                {
                                    <img class="maatwerk-example-img" src="data:image/png;base64," alt="SnelStart bevestiging nieuwe sleutel" />
                                }
                            </li>
                            <li>Kopieer de gegenereerde sleutel en plak deze in het veld hierboven.</li>
                        </ol>
                    </div>
                }
            </div>
        </div>
    }

    @* ─── SECTIE 2: Administraties ─── *@
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>SnelStart administraties</strong>
            <button class="btn btn-sm btn-outline-success" @onclick="ToggleNewAdmin">
                @(showNewAdmin ? "Annuleren" : "+ Nieuwe administratie")
            </button>
        </div>
        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(adminSuccess))
            {
                <div class="alert alert-success py-2">@adminSuccess</div>
            }
            @if (!string.IsNullOrWhiteSpace(adminError))
            {
                <div class="alert alert-danger py-2">@adminError</div>
            }

            @if (showNewAdmin)
            {
                <div class="border rounded p-3 mb-3 bg-light">
                    <h6 class="mb-3">Nieuwe administratie</h6>
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label">Maatwerksleutel</label>
                            <input class="form-control" type="password" @bind="newAdmin.AdministrationClientKey" autocomplete="off" />
                        </div>
                                                <div class="col-md-2 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="newAdminActive" @bind="newAdmin.IsActive" />
                                <label class="form-check-label" for="newAdminActive">Actief</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-success btn-sm" @onclick="CreateAdminAsync" disabled="@isSavingAdmin">
                                @(isSavingAdmin ? "Aanmaken..." : "Aanmaken")
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (administrations.Count == 0)
            {
                <div class="text-muted">Nog geen administraties aangemaakt.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Interne naam</th>
                                <th>SnelStart administratienaam</th>
                                <th class="text-center">Maatwerksleutel</th>
                                <th class="text-center">Actief</th>
                                <th>Aangemaakt</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var admin in administrations)
                            {
                                <tr>
                                    @if (editingAdminId == admin.Id)
                                    {
                                        <td>
                                            <input class="form-control form-control-sm" @bind="editAdmin!.Name"
                                                   placeholder="Interne naam" />
                                        </td>
                                        <td>
                                            <input class="form-control form-control-sm" @bind="editAdmin!.NameSnelStartAdministration"
                                                   placeholder="SnelStart administratienaam" />
                                        </td>
                                        <td>
                                            <input class="form-control form-control-sm" type="password"
                                                   @bind="editAdminClientKey"
                                                   placeholder="@(admin.HasClientKey ? "Laat leeg om te behouden" : "Vul in")"
                                                   autocomplete="off" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" @bind="editAdmin!.IsActive" />
                                        </td>
                                        <td>@admin.CreatedUtc.ToString("dd-MM-yyyy")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-primary me-1" @onclick="() => SaveAdminAsync(admin.Id)" disabled="@isSavingAdmin">
                                                @(isSavingAdmin ? "..." : "Opslaan")
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEditAdmin">
                                                Annuleren
                                            </button>
                                        </td>
                                    }
                                    else
                                    {
                                        <td><strong>@admin.Name</strong></td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(admin.NameSnelStartAdministration))
                                            {
                                                @admin.NameSnelStartAdministration
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">Niet ingesteld</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (admin.HasClientKey)
                                            {
                                                <span class="badge bg-success">Ingesteld</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Ontbreekt</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @(admin.IsActive ? "bg-success" : "bg-secondary")">
                                                @(admin.IsActive ? "Ja" : "Nee")
                                            </span>
                                        </td>
                                        <td>@admin.CreatedUtc.ToString("dd-MM-yyyy")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditAdmin(admin)">
                                                Bewerken
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ─── SECTIE 3: Bankaccounts & koppelingen ─── *@
    <div class="card">
        <div class="card-header">
            <strong>Bankaccounts &amp; SnelStart-koppelingen</strong>
        </div>
        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(linkSuccess))
            {
                <div class="alert alert-success py-2">@linkSuccess</div>
            }
            @if (!string.IsNullOrWhiteSpace(linkError))
            {
                <div class="alert alert-danger py-2">@linkError</div>
            }

            @if (bankAccountRows.Count == 0)
            {
                <div class="text-muted">Geen bankaccounts gevonden voor uw account.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>IBAN</th>
                                <th>Naam</th>
                                <th>Administratie</th>
                                <th>Export formaat</th>
                                <th class="text-center">Auto-sync</th>
                                <th class="text-center">Interval (min)</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in bankAccountRows)
                            {
                                <tr class="@(!row.BankAccount.IsActive ? "text-muted" : "")">
                                    <td>@row.BankAccount.Iban</td>
                                    <td>@row.BankAccount.AccountName</td>
                                    <td style="min-width:200px">
                                        <select class="form-select form-select-sm"
                                                value="@FormatGuid(row.Link?.SnelStartAdministrationId)"
                                                @onchange="e => OnAdminChanged(row, e)">
                                            <option value="">-- Geen koppeling --</option>
                                            @foreach (var admin in administrations)
                                            {
                                                <option value="@admin.Id">@(admin.NameSnelStartAdministration ?? admin.Name)</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm"
                                                value="@(row.Link?.ExportFormat ?? "Mt940")"
                                                @onchange="e => OnFormatChanged(row, e)">
                                            <option value="Mt940">MT940</option>
                                            <option value="Camt053">CAMT053</option>
                                        </select>
                                    </td>
                                    <td class="text-center">
                                        <input type="checkbox"
                                               checked="@(row.Link?.AutoSyncEnabled ?? true)"
                                               @onchange="e => OnAutoSyncChanged(row, e)" />
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm" type="number" style="width:80px"
                                               value="@(row.Link?.SyncIntervalMinutes ?? 15)"
                                               @onchange="e => OnIntervalChanged(row, e)" min="1" />
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-primary"
                                                @onclick="() => SaveLinkAsync(row)"
                                                disabled="@row.IsSaving">
                                            @(row.IsSaving ? "..." : (row.Link is null ? "Koppelen" : "Opslaan"))
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="form-text mt-2">
                    Wijzigingen per rij opslaan met de knop rechts. Laat "Administratie" leeg om een koppeling te verwijderen of niet in te stellen.
                </div>
            }
        </div>
    </div>
}

<style>
    .fixed-url-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .fixed-url-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #F3F4F6;
        border: 1px solid #D1D5DB;
        border-radius: 6px;
        padding: 5px 12px;
        font-size: .82rem;
        color: #374151;
        font-family: monospace;
    }

    .fixed-url-label {
        font-family: sans-serif;
        font-weight: 600;
        font-size: .75rem;
        color: #6B7280;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-right: 2px;
    }

    .maatwerk-help-toggle { margin-top: 6px; }

    .maatwerk-help-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #EFF6FF;
        border: 1px solid #BFDBFE;
        border-radius: 6px;
        padding: 5px 12px;
        font-size: .82rem;
        font-weight: 600;
        color: #1D4ED8;
        cursor: pointer;
        transition: background .15s;
    }

    .maatwerk-help-btn:hover { background: #DBEAFE; }

    .maatwerk-help-chevron { font-size: .7rem; margin-left: 2px; }

    .maatwerk-help-panel {
        background: #F8FAFF;
        border: 1px solid #BFDBFE;
        border-radius: 8px;
        padding: 14px 16px;
        margin-top: 8px;
        overflow-x: auto;
    }

    .maatwerk-help-intro {
        font-size: .84rem;
        font-weight: 600;
        color: #1E3A5F;
        margin-bottom: 10px;
    }

    .maatwerk-help-steps {
        font-size: .83rem;
        color: #374151;
        line-height: 1.7;
        padding-left: 20px;
        margin: 0;
    }

    .maatwerk-help-steps li { margin-bottom: 6px; }

    .maatwerk-example-toggle { margin-top: 4px; }

    .maatwerk-example-btn {
        background: none;
        border: 1px solid #93C5FD;
        border-radius: 5px;
        padding: 2px 10px;
        font-size: .78rem;
        color: #1D4ED8;
        cursor: pointer;
    }

    .maatwerk-example-btn:hover { background: #EFF6FF; }

    .maatwerk-example-img {
        display: block;
        width: 100%;
        max-width: 860px;
        border: 1px solid #D1D5DB;
        border-radius: 6px;
        margin-top: 8px;
        cursor: zoom-in;
    }

    .maatwerk-example-img.zoomed {
        max-width: 100%;
        cursor: zoom-out;
    }
</style>

<script>
    document.addEventListener('click', function (e) {
        if (e.target.classList.contains('maatwerk-example-img')) {
            e.target.classList.toggle('zoomed');
        }
    });
</script>

@code {
    private Guid TenantId => Session.TenantId ?? TenantOptions.Value.TenantId;

    // Sectie 1
    private TenantSnelStartConnectionViewModel? connection;
    private CreateTenantSnelStartConnectionRequestViewModel createConn = new();
    private string? connSubscriptionKey;
    private bool isSavingConn;
    private string? connSuccess;
    private string? connError;

    // Maatwerksleutel (ClientKey op verbindingsniveau)
    private string? clientKeyInput;
    private bool isSavingClientKey;
    private string? clientKeySuccess;
    private string? clientKeyError;
    private bool _isTesting;
    private ConnectionTestResultViewModel? _testResult;

    // Sectie 2
    private List<SnelStartAdministrationViewModel> administrations = [];
    private bool showNewAdmin;
    private bool _showMaatwerkHelp;
    private bool _showSs02;
    private bool _showSs03;
    private bool _showSs04;
    private CreateSnelStartAdministrationRequestViewModel newAdmin = new();
    private Guid? editingAdminId;
    private UpdateSnelStartAdministrationRequestViewModel? editAdmin;
    private string? editAdminClientKey;
    private bool isSavingAdmin;
    private string? adminSuccess;
    private string? adminError;

    // Sectie 3
    private List<BankAccountRow> bankAccountRows = [];
    private string? linkSuccess;
    private string? linkError;

    private bool isLoading;
    private string? pageError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        pageError = null;
        connSuccess = null;
        adminSuccess = null;
        linkSuccess = null;

        try
        {
            var connTask    = BackendApiClient.GetTenantSnelStartConnectionAsync(TenantId);
            var adminsTask  = BackendApiClient.GetSnelStartAdministrationsByTenantAsync(TenantId);
            var accountsTask = BackendApiClient.GetBankAccountsAsync(TenantId);

            await Task.WhenAll(connTask, adminsTask, accountsTask);

            connection      = connTask.Result;
            administrations = adminsTask.Result.OrderBy(a => a.Name).ToList();
            connSubscriptionKey = null;

            var accounts = accountsTask.Result;
            var rows = new List<BankAccountRow>();

            foreach (var account in accounts.OrderBy(a => a.AccountName))
            {
                var link = await BackendApiClient.GetBankAccountSnelStartLinkByBankAccountIdAsync(account.Id);
                rows.Add(new BankAccountRow
                {
                    BankAccount         = account,
                    Link                = link,
                    PendingAdminId      = link?.SnelStartAdministrationId,
                    PendingFormat       = link?.ExportFormat ?? "Mt940",
                    PendingAutoSync     = link?.AutoSyncEnabled ?? true,
                    PendingInterval     = link?.SyncIntervalMinutes ?? 15
                });
            }

            bankAccountRows = rows;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SnelStart koppeling laden mislukt.");
            pageError = $"Laden mislukt: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // ── Sectie 1 ──────────────────────────────────────────────────────────

    private async Task CreateConnectionAsync()
    {
        connError = null;
        connSuccess = null;

        if (string.IsNullOrWhiteSpace(createConn.SubscriptionKey))
        {
            connError = "Maatwerksleutel is verplicht.";
            return;
        }

        isSavingConn = true;
        try
        {
            createConn.AuthUrl    = "https://auth.snelstart.nl/b2b/token";
            createConn.ApiBaseUrl = "https://b2bapi.snelstart.nl/v2";
            await BackendApiClient.CreateTenantSnelStartConnectionAsync(TenantId, createConn);
            connSuccess = "Verbinding aangemaakt.";
            createConn = new();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            connError = $"Aanmaken mislukt: {ex.Message}";
        }
        finally { isSavingConn = false; }
    }

    private async Task SaveConnectionAsync()
    {
        connError = null;
        connSuccess = null;

        if (connection is null) return;

        isSavingConn = true;
        try
        {
            var request = new UpdateTenantSnelStartConnectionRequestViewModel
            {
                ConnectionType  = connection.ConnectionType,
                AuthUrl         = "https://auth.snelstart.nl/b2b/token",
                ApiBaseUrl      = "https://b2bapi.snelstart.nl/v2",
                SubscriptionKey = string.IsNullOrWhiteSpace(connSubscriptionKey) ? null : connSubscriptionKey.Trim(),
                IsActive        = connection.IsActive
            };

            await BackendApiClient.UpdateTenantSnelStartConnectionAsync(TenantId, connection.Id, request);
            connSuccess = "Verbinding opgeslagen.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            connError = $"Opslaan mislukt: {ex.Message}";
        }
        finally { isSavingConn = false; }
    }

