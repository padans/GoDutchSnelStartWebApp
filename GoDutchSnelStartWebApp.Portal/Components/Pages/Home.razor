@page "/"
@using GoDutchSnelStartWebApp.Portal.Services
@inject AppSession Session

<PageTitle>Start</PageTitle>

<h1 class="page-title mb-1">Welkom@(!string.IsNullOrEmpty(Session.TenantName) ? $", {Session.TenantName}" : "")</h1>
<p class="text-muted mb-4">Volg de stappen hieronder om de koppeling in te stellen en transacties naar SnelStart te verwerken.</p>

@if (Session.Module == "MyPos" || Session.Module == "Beheerder")
{
    <div class="start-card mb-4">
        <div class="start-card-header">
            <span class="start-card-icon">🖥️</span>
            <div>
                <div class="start-card-title">MyPos → SnelStart — Aan de slag</div>
                <div class="start-card-sub">Volg deze stappen in volgorde om de koppeling volledig in te stellen.</div>
            </div>
        </div>

        <ol class="start-steps">
            <li>
                <div class="step-title">
                    <a href="snelstart/connection">SnelStart verbinding instellen</a>
                </div>
                <div class="step-desc">
                    Voer uw SnelStart maatwerksleutel in via het menu <strong>SnelStart koppeling</strong>.
                    Zonder werkende SnelStart-koppeling kunnen er geen dagboeken worden opgehaald en kunnen
                    transacties niet naar SnelStart worden geboekt.
                </div>
            </li>
            <li>
                <div class="step-title">
                    <a href="mypos/snelstart-verbinding">SnelStart-verbinding instellen</a>
                </div>
                <div class="step-desc">
                    Maak in SnelStart een bankdagboek aan voor myPOS (bijv. <em>1150 – MyPos Bank</em>) en
                    selecteer dit hier. Het virtuele IBAN (<strong>IE91MPOS99039025035759</strong>) moet ook
                    als bankrekening in SnelStart bestaan, gekoppeld aan dit dagboek.
                </div>
            </li>
            <li>
                <div class="step-title">
                    <a href="mypos/verbinding">myPOS verbinding instellen</a>
                </div>
                <div class="step-desc">
                    Vul uw myPOS Klantnummer en Klantgeheim in. De API-gegevens vindt u in het
                    myPOS-portaal onder <em>Instellingen → Integraties → API</em>.
                </div>
            </li>
            <li>
                <div class="step-title">
                    <a href="mypos/administrations">MyPos administratie instellen</a>
                </div>
                <div class="step-desc">
                    Koppel uw SnelStart-administratie aan de myPOS-module. Stel hier de grootboekrekening
                    en het myPOS IBAN-bankrekeningnummer in.
                </div>
            </li>
            <li>
                <div class="step-title">
                    <a href="mypos/mappings">Transactietype mappings instellen</a>
                </div>
                <div class="step-desc">
                    Koppel elk myPOS-transactietype aan een SnelStart-grootboekrekening. Klik op
                    <strong>Standaard transactietypes laden</strong> om de 32 bekende types automatisch toe te voegen.
                    Wijs vervolgens per type de bijbehorende grootboekrekening toe. Zonder mappings kunnen transacties
                    niet naar SnelStart worden geëxporteerd.
                </div>
            </li>
            <li>
                <div class="step-title">
                    <a href="mypos/import">Transacties importeren</a>
                </div>
                <div class="step-desc">
                    Haal myPOS-transacties op voor een gewenste periode. De transacties worden opgeslagen als ruwe
                    data en gegroepeerd per transactietype. Controleer de totalen voordat u exporteert.
                </div>
            </li>
            <li>
                <div class="step-title">
                    <a href="mypos/import">Exportbatch aanmaken en naar SnelStart verzenden</a>
                </div>
                <div class="step-desc">
                    Maak een exportbatch aan voor de gewenste periode. De batch wordt aangemaakt als concept — controleer
                    de bedragen en klik daarna op <strong>Exporteren naar SnelStart</strong>. De transacties worden dan
                    als bankboekingen ingeboekt in SnelStart.
                </div>
            </li>
            <li>
                <div class="step-title">
                    <a href="mypos/auto-sync">Auto-sync inschakelen <span class="step-optional">optioneel</span></a>
                </div>
                <div class="step-desc">
                    Stel automatisch ophalen en exporteren in via de achtergrondworker. Zodra de koppeling werkt
                    en mappings volledig zijn ingevuld, worden transacties dagelijks automatisch verwerkt zonder
                    handmatig ingrijpen.
                </div>
            </li>
        </ol>
    </div>
}

@if (Session.Module == "GoDutch" || Session.Module == "Beheerder")
{
    <div class="start-card mb-4">
        <div class="start-card-header">
            <span class="start-card-icon">🏦</span>
            <div>
                <div class="start-card-title">GoDutch → SnelStart — Aan de slag</div>
                <div class="start-card-sub">Volg deze stappen in volgorde om de koppeling volledig in te stellen.</div>
            </div>
        </div>

        <ol class="start-steps">
            <li>
                <div class="step-title">
                    <a href="snelstart/connection">SnelStart koppeling instellen</a>
                </div>
                <div class="step-desc">
                    Vul uw SnelStart API-sleutel in. Deze vindt u in SnelStart onder
                    <em>Instellingen → API-koppelingen</em>. Zonder geldige sleutel kunnen er geen transacties
                    worden geüpload naar SnelStart.
                </div>
            </li>
            <li>
                <div class="step-title">
                    <a href="snelstart/administrations">SnelStart administratie toevoegen</a>
                </div>
                <div class="step-desc">
                    Voeg de SnelStart-administratie toe die u wilt gebruiken voor de import. U kunt meerdere
                    administraties koppelen voor verschillende bankrekeningen.
                </div>
            </li>
            <li>
                <div class="step-title">
                    <a href="bankaccounts">Bankaccount koppelen</a>
                </div>
                <div class="step-desc">
                    Voeg uw GoDutch-bankrekening(en) toe en koppel ze aan de juiste SnelStart-administratie.
                    Stel het exportformaat in (MT940 of CAMT053) en koppel de dagboek- en grootboekrekening.
                </div>
            </li>
            <li>
                <div class="step-title">
                    <a href="godutch/sync">Sync &amp; instellingen configureren</a>
                </div>
                <div class="step-desc">
                    Importeer transacties handmatig voor een gewenste periode, of schakel de auto-sync in voor
                    automatische dagelijkse verwerking. De achtergrondworker haalt transacties op en uploadt
                    ze rechtstreeks naar SnelStart.
                </div>
            </li>
        </ol>
    </div>
}

<style>
    .page-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #111827;
    }

    .start-card {
        background: #ffffff;
        border: 1px solid #E5E7EB;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,.05);
    }

    .start-card-header {
        background: #0066CC;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 24px;
    }

    .start-card-icon {
        font-size: 1.8rem;
        line-height: 1;
        flex-shrink: 0;
    }

    .start-card-title {
        font-weight: 700;
        font-size: 1rem;
        line-height: 1.2;
    }

    .start-card-sub {
        font-size: .82rem;
        color: rgba(255,255,255,.8);
        margin-top: 3px;
    }

    .start-steps {
        list-style: none;
        counter-reset: steps;
        padding: 8px 0;
        margin: 0;
    }

    .start-steps li {
        counter-increment: steps;
        display: flex;
        flex-direction: column;
        gap: 5px;
        padding: 18px 24px 18px 72px;
        position: relative;
        border-bottom: 1px solid #F3F4F6;
    }

    .start-steps li:last-child {
        border-bottom: none;
    }

    .start-steps li::before {
        content: counter(steps);
        position: absolute;
        left: 24px;
        top: 18px;
        width: 32px;
        height: 32px;
        background: #EFF6FF;
        color: #0066CC;
        border-radius: 50%;
        font-weight: 700;
        font-size: .9rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .step-title {
        font-weight: 600;
        font-size: .95rem;
        color: #111827;
    }

    .step-title a {
        color: #0066CC;
        text-decoration: none;
    }

    .step-title a:hover {
        text-decoration: underline;
    }

    .step-desc {
        font-size: .86rem;
        color: #4B5563;
        line-height: 1.6;
    }

    .step-optional {
        font-size: .75rem;
        font-weight: 600;
        background: #F3F4F6;
        color: #6B7280;
        border-radius: 20px;
        padding: 2px 9px;
        vertical-align: middle;
        margin-left: 6px;
    }
</style>
