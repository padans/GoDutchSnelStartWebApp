@page "/mypos/verbinding"

@using GoDutchSnelStartWebApp.Portal.Configuration
@using GoDutchSnelStartWebApp.Portal.Models
@using GoDutchSnelStartWebApp.Portal.Models.MyPos
@using Microsoft.Extensions.Options

@inject GoDutchSnelStartWebApp.Portal.Api.Interfaces.IBackendApiClient BackendApiClient
@inject IOptions<PortalTenantOptions> TenantOptions
@inject ILogger<MyPosVerbinding> Logger
@inject AppSession Session
@inject IJSRuntime JS

<PageTitle>myPOS API-verbinding</PageTitle>

<h1>myPOS API-verbinding</h1>
<p class="text-muted">Voer uw myPOS API-gegevens in (Klantnummer en Klantgeheim).</p>

<!-- ── Stap 1: SnelStart-maatwerksleutel ────────────────────────────────── -->
<div class="setup-step-box mb-3">
    <div class="setup-step-number">1</div>
    <div class="setup-step-body">
        <strong>Voer eerst de SnelStart-maatwerksleutel in</strong><br>
        <span>Ga naar <a href="/snelstart/connection">SnelStart koppeling</a> en voer uw maatwerksleutel in.</span>
    </div>
</div>

<!-- ── Stap 2: myPOS API-gegevens ───────────────────────────────────────── -->
<div class="setup-step-box mb-3">
    <div class="setup-step-number">2</div>
    <div class="setup-step-body">
        <strong>Voer hieronder uw myPOS API-gegevens in</strong><br>
        <span>Klantnummer en Klantgeheim uit de myPOS REST API-integratie.</span>
    </div>
</div>

<!-- ── Stap 3: SnelStart-bankdagboek koppelen ───────────────────────────── -->
<div class="setup-step-box mb-4">
    <div class="setup-step-number">3</div>
    <div class="setup-step-body">
        <strong>Koppel daarna het SnelStart-bankdagboek</strong><br>
        <span>
            Op <a href="/mypos/snelstart-verbinding">SnelStart-verbinding</a> kies je het bankdagboek
            (bijv. <em>1150 – MyPos Bank</em>). Maak dat dagboek zo nodig eerst aan in SnelStart.
        </span>
    </div>
</div>

@if (isLoading)
{
    <p>Gegevens laden...</p>
}
else if (connection is null)
{
    <!-- ── Aanmaakformulier: alleen de myPOS API-gegevens. Het SnelStart-bankdagboek
         koppel je daarna op /mypos/snelstart-verbinding (stap 3 van het stappenplan). ── -->
    <div class="card mb-3">
        <div class="card-header">MyPos API-gegevens</div>
        <div class="card-body">
            <div class="fixed-info-row mb-3">
                <div class="fixed-info-item">
                    <span class="fixed-info-label">Auth URL</span>
                    <span class="fixed-info-value">https://auth-api.mypos.com/oauth/token</span>
                </div>
                <div class="fixed-info-item">
                    <span class="fixed-info-label">Transactions API URL</span>
                    <span class="fixed-info-value">https://transactions-api.mypos.com/v1.1</span>
                </div>
                <div class="fixed-info-item">
                    <span class="fixed-info-label">Virtueel IBAN</span>
                    <span class="fixed-info-value">IE91MPOS99039025035759</span>
                    <button class="copy-btn" title="Kopieer IBAN" @onclick="CopyIban">@_ibanCopied</button>
                </div>
            </div>

            <div class="cred-help-toggle mb-3">
                <button type="button" class="cred-help-btn" @onclick="() => _showHelp = !_showHelp">
                    <span>ℹ️</span>
                    <span>Hoe haal ik mijn API-gegevens op uit myPOS?</span>
                    <span class="cred-help-chevron">@(_showHelp ? "▲" : "▼")</span>
                </button>
                @if (_showHelp)
                {
                    <div class="cred-help-panel">
                        <p class="cred-help-intro">Volg deze stappen om uw myPOS Klantnummer en Klantgeheim op te halen:</p>
                        <ol class="cred-help-steps">
                            <li>
                                <strong>Log eerst in op uw telefoon</strong> — myPOS vereist telefoonbevestiging
                                bij inloggen op de computer.
                            </li>
                            <li>
                                Log in op uw computer via
                                <a href="https://merchant.mypos.com/nl/login" target="_blank" rel="noopener">
                                    merchant.mypos.com/nl/login
                                </a>
                                en bevestig het inloggen op uw telefoon.
                            </li>
                            <li>
                                Ga in het linkermenu naar <strong>Integraties</strong> of open direct:
                                <a href="https://merchant.mypos.com/nl/account#/integration/rest-api" target="_blank" rel="noopener">
                                    REST API-integratie
                                </a>
                            </li>
                            <li>
                                Klik op <strong>+ Nieuwe referenties genereren</strong>. U ziet dan een tabel met
                                uw <em>Klantnummer</em> en <em>Klantgeheim</em>. Kopieer deze waarden hieronder.
                            </li>
                        </ol>
                        <div class="cred-example-toggle mt-3">
                            <button type="button" class="cred-example-btn" @onclick="() => _showExample = !_showExample">
                                <span>🖼️</span>
                                <span>@(_showExample ? "Verberg voorbeeld" : "Toon voorbeeld myPOS-scherm")</span>
                            </button>
                            @if (_showExample)
                            {
                                <div class="cred-example-img">
                                    <img src="data:image/png;base64," alt="myPOS REST API integratiescherm" style="max-width:100%;border-radius:8px;border:1px solid #E5E7EB;" />
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Klantnummer <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="createForm.ClientId" placeholder="Uw myPOS klantnummer" autocomplete="off" />
                    <div class="form-text">Klantnummer (Client ID) zoals getoond in myPOS</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Klantgeheim</label>
                    <input class="form-control" type="password" @bind="createForm.ClientSecret" placeholder="Uw myPOS klantgeheim" autocomplete="new-password" />
                    <div class="form-text">Klantgeheim (Client Secret) zoals getoond in myPOS</div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger mt-3 py-2" role="alert">@errorMessage</div>
            }
            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success mt-3 py-2" role="alert">@successMessage</div>
            }
            <div class="mt-3">
                <button class="btn btn-primary" @onclick="CreateAsync" disabled="@isSaving">
                    @(isSaving ? "Aanmaken..." : "Koppeling aanmaken")
                </button>
            </div>
            <p class="text-muted mt-3 mb-0">
                Na het aanmaken koppel je het SnelStart-bankdagboek op
                <a href="/mypos/snelstart-verbinding">SnelStart-verbinding</a> (stap 3).
            </p>
        </div>
    </div>
}
else
{
    <!-- ── Bewerkformulier (bestaande koppeling) ───────────────────────── -->

    <!-- myPOS API-gegevens -->

    <div class="card mb-3">
        <div class="card-header">myPOS API-gegevens</div>
        <div class="card-body">
            <div class="fixed-info-row mb-3">
                <div class="fixed-info-item">
                    <span class="fixed-info-label">Auth URL</span>
                    <span class="fixed-info-value">https://auth-api.mypos.com/oauth/token</span>
                </div>
                <div class="fixed-info-item">
                    <span class="fixed-info-label">Transactions API URL</span>
                    <span class="fixed-info-value">https://transactions-api.mypos.com/v1.1</span>
                </div>
                <div class="fixed-info-item">
                    <span class="fixed-info-label">Virtueel IBAN</span>
                    <span class="fixed-info-value">IE91MPOS99039025035759</span>
                    <button class="copy-btn" title="Kopieer IBAN" @onclick="CopyIban">@_ibanCopied</button>
                </div>
            </div>

            <div class="cred-help-toggle mb-3">
                <button type="button" class="cred-help-btn" @onclick="() => _showHelp = !_showHelp">
                    <span>ℹ️</span>
                    <span>Hoe haal ik mijn API-gegevens op uit myPOS?</span>
                    <span class="cred-help-chevron">@(_showHelp ? "▲" : "▼")</span>
                </button>
                @if (_showHelp)
                {
                    <div class="cred-help-panel">
                        <p class="cred-help-intro">Volg deze stappen om uw myPOS Klantnummer en Klantgeheim op te halen:</p>
                        <ol class="cred-help-steps">
                            <li>
                                <strong>Log eerst in op uw telefoon</strong> — myPOS vereist telefoonbevestiging
                                bij inloggen op de computer.
                            </li>
                            <li>
                                Log in op uw computer via
                                <a href="https://merchant.mypos.com/nl/login" target="_blank" rel="noopener">
                                    merchant.mypos.com/nl/login
                                </a>
                                en bevestig het inloggen op uw telefoon.
                            </li>
                            <li>
                                Ga in het linkermenu naar <strong>Integraties</strong> of open direct:
                                <a href="https://merchant.mypos.com/nl/account#/integration/rest-api" target="_blank" rel="noopener">
                                    REST API-integratie
                                </a>
                            </li>
                            <li>
                                Klik op <strong>+ Nieuwe referenties genereren</strong>. U ziet dan een tabel met
                                uw <em>Klantnummer</em> en <em>Klantgeheim</em>. Kopieer deze waarden hieronder.
                            </li>
                        </ol>
                        <div class="cred-example-toggle mt-3">
                            <button type="button" class="cred-example-btn" @onclick="() => _showExample = !_showExample">
                                <span>🖼️</span>
                                <span>@(_showExample ? "Verberg voorbeeld" : "Toon voorbeeld myPOS-scherm")</span>
                            </button>
                            @if (_showExample)
                            {
                                <div class="cred-example-img">
                                    <img src="data:image/png;base64," alt="myPOS REST API integratiescherm" style="max-width:100%;border-radius:8px;border:1px solid #E5E7EB;" />
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Klantnummer</label>
                    <input class="form-control" @bind="_clientId" placeholder="Laat leeg om te behouden" autocomplete="off" />
                    <div class="form-text">Opgeslagen: @(!string.IsNullOrEmpty(connection.ClientId) ? "✓ Ja" : "Nee") — laat leeg om huidige waarde te behouden</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Klantgeheim</label>
                    <input type="text" style="display:none" aria-hidden="true" tabindex="-1" />
                    <input type="password" style="display:none" aria-hidden="true" tabindex="-1" />
                    <input class="form-control" type="password" @bind="clientSecret" placeholder="Laat leeg om te behouden" autocomplete="off" />
                    <div class="form-text">Opgeslagen: @(connection.HasClientSecret ? "✓ Ja" : "Nee") — laat leeg om huidige waarde te behouden</div>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check mb-2">
