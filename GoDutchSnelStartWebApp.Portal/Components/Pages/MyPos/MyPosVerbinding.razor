@code {
    private Guid TenantId => Session.TenantId ?? TenantOptions.Value.TenantId;

    private TenantMyPosConnectionViewModel? connection;
    private readonly CreateMyPosConnectionRequestViewModel createForm = new();
    private List<SnelStartDagboekLookupViewModel> dagboeken = [];

    private bool isLoading;
    private bool isSaving;
    private bool _isSavingCreds;
    private bool _showHelp;
    private bool _showExample;
    private string _ibanCopied = "📋";
    private string? _clientId;
    private string? clientSecret;
    private string? errorMessage;
    private string? successMessage;

    private string BankDagboekDisplayName =>
        (!string.IsNullOrWhiteSpace(connection?.SnelStartBankDagboekNummer) &&
         !string.IsNullOrWhiteSpace(connection?.SnelStartBankDagboekNaam))
            ? $"{connection.SnelStartBankDagboekNummer} - {connection.SnelStartBankDagboekNaam}"
            : "-";

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        errorMessage = null;
        successMessage = null;
        isLoading = true;

        try
        {
            connection = await BackendApiClient.GetTenantMyPosConnectionAsync(TenantId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "myPOS koppeling laden mislukt.");
            errorMessage = $"myPOS koppeling laden mislukt: {ex.Message}";
        }

        // Dagboeken apart ophalen — mag mislukken als SnelStart nog niet gekoppeld is
        try
        {
            var result = await BackendApiClient.GetTenantSnelStartDagboekenAsync(TenantId);
            dagboeken = result.OrderBy(x => x.Nummer).ThenBy(x => x.Omschrijving).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "SnelStart-dagboeken ophalen mislukt (nog geen koppeling?).");
            dagboeken = [];
        }

        _clientId = null;
        clientSecret = null;
        isLoading = false;
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(createForm.ClientId))
        {
            errorMessage = "Klantnummer is verplicht.";
            return;
        }
        // Het SnelStart-bankdagboek is hier optioneel; dat koppel je op /mypos/snelstart-verbinding.

        errorMessage = null;
        isSaving = true;

        try
        {
            createForm.ApiKey = createForm.ClientSecret;
            await BackendApiClient.CreateTenantMyPosConnectionAsync(TenantId, createForm);
            successMessage = "myPOS-koppeling aangemaakt.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "myPOS koppeling aanmaken mislukt.");
            errorMessage = $"Aanmaken mislukt: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OnDagboekChanged(ChangeEventArgs args)
    {
        if (connection is null) return;
        if (!Guid.TryParse(args.Value?.ToString(), out var id))
        {
            connection.SnelStartBankDagboekId = null;
            connection.SnelStartBankDagboekNummer = null;
            connection.SnelStartBankDagboekNaam = null;
            return;
        }
        var d = dagboeken.FirstOrDefault(x => x.Id == id);
        connection.SnelStartBankDagboekId = d?.Id;
        connection.SnelStartBankDagboekNummer = d?.Nummer;
        connection.SnelStartBankDagboekNaam = d?.Omschrijving;
    }

    private async Task SaveMyPosCredsAsync()
    {
        errorMessage = null;
        successMessage = null;

        if (connection is null || connection.Id == Guid.Empty) { errorMessage = "Geen geldige koppeling geladen."; return; }
        if (string.IsNullOrWhiteSpace(_clientId) && string.IsNullOrWhiteSpace(connection.ClientId)) { errorMessage = "Klantnummer is verplicht."; return; }

        _isSavingCreds = true;
        try
        {
            var request = new UpdateTenantMyPosConnectionRequestViewModel
            {
                AuthUrl = "https://auth-api.mypos.com/oauth/token",
                TransactionsApiBaseUrl = "https://transactions-api.mypos.com/v1.1",
                ClientId = string.IsNullOrWhiteSpace(_clientId) ? connection.ClientId!.Trim() : _clientId.Trim(),
                ClientSecret = string.IsNullOrWhiteSpace(clientSecret) ? null : clientSecret.Trim(),
                ApiKey = string.IsNullOrWhiteSpace(clientSecret) ? null : clientSecret.Trim(),
                SnelStartBankDagboekId = connection.SnelStartBankDagboekId,
                SnelStartBankDagboekNummer = NormalizeNullable(connection.SnelStartBankDagboekNummer),
                SnelStartBankDagboekNaam = NormalizeNullable(connection.SnelStartBankDagboekNaam),
                SnelStartBankIban = "IE91MPOS99039025035759",
                IsActive = connection.IsActive
            };

            await BackendApiClient.UpdateTenantMyPosConnectionAsync(TenantId, connection.Id, request);
            successMessage = "myPOS API-gegevens opgeslagen.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "myPOS API-gegevens opslaan mislukt.");
            errorMessage = $"Opslaan mislukt: {ex.Message}";
        }
        finally
        {
            _isSavingCreds = false;
        }
    }

    private static string FormatGuid(Guid? value) =>
        value.HasValue && value.Value != Guid.Empty ? value.Value.ToString() : string.Empty;

    private static string? NormalizeNullable(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task CopyIban()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", "IE91MPOS99039025035759");
        _ibanCopied = "✓";
        StateHasChanged();
        await Task.Delay(2000);
        _ibanCopied = "📋";
        StateHasChanged();
    }
}

