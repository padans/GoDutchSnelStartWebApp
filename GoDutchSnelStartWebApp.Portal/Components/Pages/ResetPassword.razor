@page "/reset-password"
@layout PublicLayout
@using GoDutchSnelStartWebApp.Portal.Api.Interfaces
@using GoDutchSnelStartWebApp.Portal.Components.Layout
@inject IBackendApiClient ApiClient
@inject NavigationManager Navigation

<div class="reset-card">
    <div class="reset-brand">
        <div class="reset-brand-logo">GS</div>
        <div class="reset-brand-title">GoDutch MyPos SnelStart</div>
    </div>

    @if (_token is null)
    {
        <div class="reset-error-block">
            <div class="reset-icon">⚠️</div>
            <h1 class="reset-title">Ongeldige link</h1>
            <p class="reset-desc">De resetlink is ongeldig of ontbreekt. Vraag een nieuwe link aan via het inlogscherm.</p>
            <a class="reset-btn" href="/">Terug naar inloggen</a>
        </div>
    }
    else if (_success)
    {
        <div class="reset-success-block">
            <div class="reset-icon">✅</div>
            <h1 class="reset-title">Wachtwoord ingesteld</h1>
            <p class="reset-desc">Uw nieuwe wachtwoord is opgeslagen. U kunt nu inloggen.</p>
            <a class="reset-btn" href="/">Naar inloggen</a>
        </div>
    }
    else
    {
        <h1 class="reset-title">Nieuw wachtwoord instellen</h1>
        <p class="reset-desc">Kies een veilig wachtwoord van minimaal 8 tekens.</p>

        <div class="reset-field">
            <label>Nieuw wachtwoord</label>
            <div class="pw-wrap">
                <input class="form-control" type="@(_showPw ? "text" : "password")" @bind="_password" placeholder="Minimaal 8 tekens" autocomplete="new-password" />
                <button type="button" class="pw-toggle" @onclick="() => _showPw = !_showPw" tabindex="-1">
                    @if (_showPw) {
                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    } else {
                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    }
                </button>
            </div>
        </div>
        <div class="reset-field">
            <label>Herhaal wachtwoord</label>
            <div class="pw-wrap">
                <input class="form-control" type="@(_showConfirm ? "text" : "password")" @bind="_confirm" placeholder="Herhaal nieuw wachtwoord" autocomplete="new-password" />
                <button type="button" class="pw-toggle" @onclick="() => _showConfirm = !_showConfirm" tabindex="-1">
                    @if (_showConfirm) {
                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    } else {
                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    }
                </button>
            </div>
        </div>

        @if (_error is not null)
        {
            <div class="reset-error">@_error</div>
        }

        <button class="reset-btn" @onclick="HandleReset" disabled="@_loading">
            @(_loading ? "Bezig…" : "Wachtwoord instellen")
        </button>
    }
</div>

@code {
    private string? _token;
    private string _password = string.Empty;
    private string _confirm = string.Empty;
    private string? _error;
    private bool _loading;
    private bool _success;
    private bool _showPw;
    private bool _showConfirm;

    protected override void OnInitialized()
    {
        var uri = new Uri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("token", out var t) && !string.IsNullOrWhiteSpace(t))
            _token = t.ToString();
    }

    private async Task HandleReset()
    {
        if (string.IsNullOrWhiteSpace(_password) || _password.Length < 8)
        {
            _error = "Wachtwoord moet minimaal 8 tekens zijn.";
            return;
        }
        if (_password != _confirm)
        {
            _error = "Wachtwoorden komen niet overeen.";
            return;
        }

        _error = null;
        _loading = true;

        try
        {
            var ok = await ApiClient.ResetPasswordAsync(_token!, _password);
            if (ok)
                _success = true;
            else
                _error = "De link is verlopen of al gebruikt. Vraag een nieuwe resetlink aan.";
        }
        catch
        {
            _error = "Er is een fout opgetreden. Probeer het opnieuw.";
        }
        finally
        {
            _loading = false;
        }
    }
}

<style>
    .reset-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 40px 36px 36px 36px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 8px 40px rgba(0, 20, 60, .25);
    }

    .reset-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
    }

    .reset-brand-logo {
        width: 40px;
        height: 40px;
        background: #0066CC;
        border-radius: 10px;
        color: #fff;
        font-size: .95rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .reset-brand-title {
        font-size: 1rem;
        font-weight: 700;
        color: #111827;
        line-height: 1.2;
    }

    .reset-icon {
        font-size: 2.8rem;
        text-align: center;
        margin-bottom: 12px;
    }

    .reset-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #111827;
        margin: 0 0 10px 0;
    }

    .reset-desc {
        font-size: .9rem;
        color: #4B5563;
        line-height: 1.6;
        margin: 0 0 24px 0;
    }

    .reset-field {
        margin-bottom: 14px;
    }

    .reset-field label {
        display: block;
        font-weight: 600;
        font-size: .84rem;
        color: #374151;
        margin-bottom: 5px;
    }

    .form-control {
        width: 100%;
        border: 1px solid #D1D5DB;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: .9rem;
        box-sizing: border-box;
        transition: border-color .15s;
    }

    .form-control:focus {
        outline: none;
        border-color: #0066CC;
        box-shadow: 0 0 0 3px rgba(0,102,204,.15);
    }

    .reset-error {
        background: #FEF2F2;
        border: 1px solid #FECACA;
        color: #DC2626;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: .84rem;
        margin-bottom: 14px;
    }

    .reset-btn {
        display: block;
        width: 100%;
        background: #0066CC;
        color: #ffffff;
        border: none;
        border-radius: 10px;
        padding: 13px;
        font-size: .95rem;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        transition: background .15s;
        box-sizing: border-box;
        margin-top: 4px;
    }

    .reset-btn:hover:not(:disabled) {
        background: #0052A8;
        color: #ffffff;
    }

    .reset-btn:disabled {
        opacity: .7;
        cursor: not-allowed;
    }

    .pw-wrap { position: relative; display: flex; align-items: center; }
    .pw-wrap .form-control { padding-right: 40px; }
    .pw-toggle { position: absolute; right: 10px; background: none; border: none; padding: 0; cursor: pointer; color: #6B7280; display: flex; align-items: center; line-height: 1; }
    .pw-toggle:hover { color: #0066CC; }

    .reset-error-block,
    .reset-success-block {
        text-align: center;
    }
</style>
